# Required for random case generation and DeepSeek-powered dynamic dialogue/feedback.
# Without it, the tutorial uses safe deterministic dialogue and review fallbacks.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# V4 always uses jsonMode to avoid function-call tool_choice/raw-tool-call incompatibilities.
DEEPSEEK_STRUCTURED_METHOD=jsonMode
# Complete case drafts are large; allow the Worker up to three minutes before treating a model call as timed out.
DEEPSEEK_TIMEOUT_MS=180000

# Optional shared password for a public deployment. Leave blank for local open access.
ACCESS_PASSWORD=

# Keep both files on the same persistent local disk when using SQLite.
DATABASE_URL=file:data/spy-game.sqlite
LANGGRAPH_CHECKPOINT_PATH=data/langgraph-checkpoints.sqlite
WORKER_POLL_MS=2000
